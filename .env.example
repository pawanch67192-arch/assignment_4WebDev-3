PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/secure_connect_db

# Use a long random string, e.g.  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=1h

BCRYPT_SALT_ROUNDS=10

# The user who signs up with this email is given the "admin" role (RBAC demo)
ADMIN_EMAIL=admin@example.com

NODE_ENV=development
